# Copy to frontend/.env.local. Only NEXT_PUBLIC_* values reach the browser: never put secrets,
# backend tokens or storage credentials in them.

# Browser REST requests go through the Next.js same-origin /api rewrite (next.config.ts).
NEXT_PUBLIC_API_URL=/api

# Server-only rewrite destination for /api/* (NOT public). Read when Next.js builds and starts,
# so restart (and rebuild for production) after changing it.
API_PROXY_TARGET=http://localhost:4000

# Real-time metadata connection (Socket.IO, /radio namespace; metadata only, never audio). Separate from
# the REST rewrite: the BROWSER connects to it directly, so it must be reachable from the listener's device.
# If it is unset or unreachable the app falls back to polling REST every few seconds.
# Testing from a phone or another PC on the network: use the host PC's LAN IP instead of localhost
# (NEXT_PUBLIC_SOCKET_URL=http://<LAN-IP>:4000), AND add the origin the other device opens
# (http://<LAN-IP>:3000) to SOCKET_ALLOWED_ORIGINS in backend/.env, then restart both. Like the
# stream URL, this value is fixed when Next.js starts/builds.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Public live listening stream (Icecast mount), never a direct storage URL. Used by the public
# player at /radio. It is read by the BROWSER, so it must be an address the listener's device can
# reach: "localhost" only works on the PC that runs Icecast.
# Testing from a phone or another PC on the same network: replace localhost with the host PC's LAN
# IP (run `ipconfig`, use the IPv4 address), e.g. NEXT_PUBLIC_STREAM_URL=http://<LAN-IP>:8000/radio.mp3,
# open http://<LAN-IP>:3000/radio on the other device, and restart (production: rebuild) the frontend,
# because NEXT_PUBLIC_* values are fixed when Next.js starts/builds. Allow ports 3000 and 8000 in the
# host firewall. `next dev` blocks other hostnames, so use `npm run build` + `npm start` for LAN tests.
NEXT_PUBLIC_STREAM_URL=http://localhost:8000/radio.mp3

# Upload size limit shown to users (MB). Keep equal to the backend AUDIO_UPLOAD_MAX_MB; the server enforces the real limit.
NEXT_PUBLIC_AUDIO_UPLOAD_MAX_MB=25
