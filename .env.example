# Streaming stack (Docker Compose: Liquidsoap + Icecast only).
# Copy to .env and replace every REPLACE_WITH_... value. Use letters, digits, - and _ only.
ICECAST_PORT=8000
ICECAST_HOSTNAME=localhost
ICECAST_SOURCE_PASSWORD=REPLACE_WITH_STRONG_SECRET
ICECAST_ADMIN_PASSWORD=REPLACE_WITH_STRONG_SECRET
ICECAST_RELAY_PASSWORD=REPLACE_WITH_STRONG_SECRET
# Liquidsoap control interface; published on 127.0.0.1 only.
LIQUIDSOAP_CONTROL_PORT=1234
# How Liquidsoap (in Docker) reaches NestJS on the host.
API_INTERNAL_URL=http://host.docker.internal:4000
# Shared secrets: must equal the values in backend/.env (at least 32 random characters each).
STREAM_INTERNAL_TOKEN=REPLACE_WITH_STRONG_SECRET
LIQUIDSOAP_CONTROL_TOKEN=REPLACE_WITH_STRONG_SECRET
