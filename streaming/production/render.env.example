# Render (Free) production settings: PLACEHOLDERS ONLY. Never put real values in this file or commit them.
# You enter the real values in the Render dashboard (Environment tab) yourself.
#
# Known today:   backend  = https://cdr-radio-backend.onrender.com
# Not known yet: streaming = https://<STREAMING_SERVICE_NAME>.onrender.com  (Render assigns it when you create
#                the streaming Web Service; replace <STREAMING_SERVICE_NAME> everywhere below with that name)
#
# Generate each secret locally, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Allowed characters in the two tokens: letters, digits and . _ ~ - (the base64url output qualifies).

# =====================================================================================================
# A. NEW Render Web Service "streaming" (Docker, Free). Environment variables to add:
# =====================================================================================================

# Where Liquidsoap reaches the NestJS backend over HTTPS (known URL, no trailing slash).
API_INTERNAL_URL=https://cdr-radio-backend.onrender.com

# Liquidsoap -> backend (/internal/stream/*). SAME VALUE as STREAM_INTERNAL_TOKEN on the backend service.
STREAM_INTERNAL_TOKEN=REPLACE_WITH_SECRET_MIN_32_CHARS

# Backend -> streaming gateway (/control/*). SAME VALUE as LIQUIDSOAP_CONTROL_TOKEN on the backend service.
LIQUIDSOAP_CONTROL_TOKEN=REPLACE_WITH_DIFFERENT_SECRET_MIN_32_CHARS

# Do NOT set PORT (Render sets it; the gateway binds 0.0.0.0:$PORT, default 10000).
# Optional: the Icecast passwords are used only inside the container (its admin/source ports are not
# reachable) and are generated at every start when unset. Leave them unset.
# ICECAST_SOURCE_PASSWORD=
# ICECAST_ADMIN_PASSWORD=
# ICECAST_RELAY_PASSWORD=

# =====================================================================================================
# B. ALREADY-DEPLOYED backend (https://cdr-radio-backend.onrender.com): add or change these
#    (Environment tab, then it redeploys). Existing database, R2, JWT and auth values stay as they are.
# =====================================================================================================

# Same values as in section A (matching pairs; never share them with the browser or the frontend).
STREAM_INTERNAL_TOKEN=REPLACE_WITH_SAME_VALUE_AS_STREAMING_SERVICE
LIQUIDSOAP_CONTROL_TOKEN=REPLACE_WITH_SAME_VALUE_AS_STREAMING_SERVICE

# NEW (server-only): where the backend sends skip/reload commands. The streaming service's public HTTPS
# origin; the gateway routes only POST /control/skip and POST /control/reload. When set, it replaces
# LIQUIDSOAP_CONTROL_HOST/PORT (leave those unset).
LIQUIDSOAP_CONTROL_URL=https://<STREAMING_SERVICE_NAME>.onrender.com

# The public stream. The backend also reads <origin>/status-json.xsl from here for stream health and
# the listener count, so it must be the same streaming origin.
ICECAST_PUBLIC_URL=https://<STREAMING_SERVICE_NAME>.onrender.com/radio.mp3

# Real-time (Socket.IO) browser origins. Add the frontend's origin once it exists (exact origin, no path,
# comma-separated, no wildcards). FRONTEND_URL must also be that origin for the cookie/CSRF rules.
# SOCKET_ALLOWED_ORIGINS=https://<FRONTEND_HOST>
# FRONTEND_URL=https://<FRONTEND_HOST>

# =====================================================================================================
# C. FRONTEND (later; do not deploy it yet). Only NEXT_PUBLIC_* values reach the browser: no secrets here.
# =====================================================================================================

# NEXT_PUBLIC_API_URL=/api
# Server-only rewrite target of /api (not NEXT_PUBLIC): the deployed backend.
# API_PROXY_TARGET=https://cdr-radio-backend.onrender.com
# Browsers connect to the backend for real-time metadata and to the streaming service for audio:
# NEXT_PUBLIC_SOCKET_URL=https://cdr-radio-backend.onrender.com
# NEXT_PUBLIC_STREAM_URL=https://<STREAMING_SERVICE_NAME>.onrender.com/radio.mp3
