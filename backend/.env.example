# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Validated at startup ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Next.js origin allowed by CORS (credentials enabled).
FRONTEND_URL=http://localhost:3000
# Reverse proxies in front of the API (0 locally). Set when deployed so rate limiting sees real client IPs.
TRUST_PROXY_HOPS=0

# Auth (at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Token and cookie lifetime: <number><s|m|h|d>. No refresh tokens: users log in again after expiry.
JWT_EXPIRES_IN=15m
# bcrypt work factor, 10-14.
BCRYPT_SALT_ROUNDS=12
AUTH_COOKIE_NAME=cdr_access_token
# true/false. Defaults to true when NODE_ENV=production (requires HTTPS).
AUTH_COOKIE_SECURE=false

# --- Used only by the seed script (npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@example.test
# At least 12 characters.
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Cloudflare R2 (private bucket; S3 API token with Object Read & Write on this bucket only) ---
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET_NAME=cdr-radio-tracks
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Lifetime of server-generated presigned GET URLs (30-3600 s).
R2_PRESIGN_TTL_SECONDS=300

# --- Audio processing (host-installed FFmpeg; command names on PATH or absolute paths) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Each ffmpeg/ffprobe run is killed after this many ms (1000-900000).
FFMPEG_TIMEOUT_MS=120000
# Maximum upload size in MB (1-200).
AUDIO_UPLOAD_MAX_MB=25
# Optional parent dir for temp audio files (default: OS temp dir); a cdr-radio-audio subfolder is used.
# AUDIO_TMP_DIR=

# --- Streaming integration (Liquidsoap in Docker <-> NestJS on the host) ---
# Liquidsoap's token-protected control interface (Docker publishes it on 127.0.0.1 only).
LIQUIDSOAP_CONTROL_HOST=127.0.0.1
LIQUIDSOAP_CONTROL_PORT=1234
# Shared secrets: must equal the values in the root .env (at least 32 random characters each).
# STREAM_INTERNAL_TOKEN: Liquidsoap -> NestJS /internal/stream/*. LIQUIDSOAP_CONTROL_TOKEN: NestJS -> Liquidsoap.
STREAM_INTERNAL_TOKEN=REPLACE_WITH_SAME_SECRET_AS_ROOT
LIQUIDSOAP_CONTROL_TOKEN=REPLACE_WITH_SAME_SECRET_AS_ROOT

# --- Real-time metadata (Socket.IO, /radio namespace; metadata only, never audio) ---
# The public Icecast mount. The backend also reads Icecast's status document from this host
# (/status-json.xsl) to report stream health and the listener count; it must be reachable from the backend.
ICECAST_PUBLIC_URL=http://localhost:8000/radio.mp3
# Milliseconds between Icecast status reads (2000-60000). One shared read, only while a client is connected.
# STREAM_STATUS_POLL_MS=5000
# Origins allowed to open the Socket.IO connection: exact origins, comma-separated, no wildcards.
# Defaults to FRONTEND_URL. For a phone or another PC on the LAN, add the origin its browser uses, e.g.
# SOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://<LAN-IP>:3000
# (Restart the backend after changing it. This does not change the REST cookie/CSRF rules, which only
# trust FRONTEND_URL.)
# SOCKET_ALLOWED_ORIGINS=http://localhost:3000

# AI_API_KEY=ONLY_WHEN_CHATBOT_IS_ADDED
